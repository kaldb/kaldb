{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "CounterID": 62
          }
        },
        {
          "range": {
            "EventDate": {
              "gte": "2013-07-01T00:00:00Z",
              "lte": "2013-07-31T23:59:59Z"
            }
          }
        },
        {
          "term": {
            "IsDownload": 0
          }
        }
      ],
      "must_not": [
        {
          "term": {
            "IsRefresh": true
          }
        },
        {
          "term": {
            "IsLink": 0
          }
        }
      ]
    }
  },
  "aggs": {
    "urls": {
      "terms": {
        "field": "URL",
        "size": 1010,
        "order": {
          "_count": "desc"
        }
      },
      "aggs": {
        "page": {
          "bucket_sort": {
            "sort": [
              {
                "_count": {
                  "order": "desc"
                }
              }
            ],
            "from": 1000,
            "size": 10
          }
        }
      }
    }
  }
}
